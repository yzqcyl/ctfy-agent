# 复制为 .env 后填写。.env 在 .gitignore 里，不会进仓库。
# 令牌来源：平台 → 设置 → API 令牌（30 天有效，随时可吊销）

CTFY_TOKEN=pf_在这里粘贴平台令牌

# DeepSeek V4.1 Flash（OpenAI 兼容端点）
# 注意：不同供应商的 base_url 不同，必须和你的 Key 配套：
#   - DeepSeek 官方：https://api.deepseek.com/v1
#   - 并行智算云（Paratera）：https://ai.paratera.com/v1   模型名 DeepSeek-V4.1-Flash-1017
DEEPSEEK_API_KEY=sk_在这里粘贴模型 Key
DEEPSEEK_BASE_URL=https://ai.paratera.com/v1
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017

# 可选覆盖（默认值见 config/agent.json）
# CTFY_MCP_URL=https://ctfy.tsinghua.edu.cn/api/v1/mcp/
# AGENT_MAX_STEPS=12
# AGENT_SUBMIT_LIMIT=3
# AGENT_MAX_CALLS_PER_STEP=8
# AGENT_INSTANCE_OPS_LIMIT=5
# AGENT_ORACLE_LIMIT=50
# AGENT_ALLOW_SHELL=false

# 费用/用量上限（硬刹车，默认只按 token 卡；跨进程累计，重跑同一题接着算）
# AGENT_MAX_TOKENS_PER_CHALLENGE=300000   # 单题累计 token 上限
# AGENT_MAX_LLM_CALLS=20                 # 单题累计模型调用次数上限
# AGENT_MAX_COST=0.0                     # 单题金额上限（0=不限；需同时配下面单价）
# AGENT_PRICE_INPUT_PER_MTOK=0.0         # 输入 token 单价（每百万 token）
# AGENT_PRICE_OUTPUT_PER_MTOK=0.0        # 输出 token 单价（每百万 token）

