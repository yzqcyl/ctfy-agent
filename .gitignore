# 凭据
.env
.env.*
!.env.example

# 平台档案（含各平台 MCP 地址/工具映射，属本机状态）
config/platforms.json
config/platforms.deleted.json

# 运行产物
runs/
logs/
*.log

# 全局 token 总账（跨题/跨进程的本机状态，含用量；不进 git）
.ctfy-global-ledger.json
.ctfy-ledger.*.tmp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 本地工具链 / 题库缓存 / 构建产物（不进镜像、也不该进 git）
.tools/
misc-bank/
dist/
.ref/
.workbuddy/

# 本地扩展依赖库（tools/fetch_pylibs.py 装进来的 wheel 解包，约 80MB，不进 git）
# 只有本地 GUI/CLI 用得上；容器镜像不带它，shell 里会自动退回纯 stdlib。
tools/pylibs/

# 收进来的第三方模块（可能内嵌凭据，且不属于镜像源码）
inbox/
